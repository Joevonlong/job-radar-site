---
import { COPY, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const t = COPY[Astro.props.lang].nav;
---

<button class="icon-btn theme-toggle" type="button" data-to-light={t.toLight} data-to-dark={t.toDark} aria-label={t.toDark}>
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor"></rect>
    <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"></path>
  </svg>
</button>

<script>
  // Same storage key and values as Starlight's theme picker ('light' | 'dark', '' = follow the system).
  const KEY = 'starlight-theme';
  const sync = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) => {
      b.setAttribute('aria-label', (dark ? b.dataset.toLight : b.dataset.toDark) ?? '');
      b.setAttribute('aria-pressed', String(dark));
    });
  };
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) =>
    b.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {}
      sync();
    }),
  );
  // Follow the system while the visitor has not chosen.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {}
    if (stored === 'light' || stored === 'dark') return;
    document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
    sync();
  });
  sync();
</script>
