---
import lockupRaw from '../../assets/brand/lockup-h-layered-light.svg?raw';
import VideoSlot from '../VideoSlot.astro';
import RadarMotif from '../RadarMotif.astro';
import { COPY, TAGLINE, type Lang } from '../../i18n/ui';
import { duration, video, vlabel } from '../../lib/site';
import { PRODUCT_REPO } from '../../../site.config.mjs';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const tag = TAGLINE[lang];
const tour = video('M-01');
// The layered lockup (from the brand kit) is inlined so the reveal can drive its cells; colours come from
// the theme tokens in CSS (.reveal #jr-face …), so one copy serves both themes.
const lockup = lockupRaw
  .replace(/<\?xml[^>]*>/, '')
  .replace(/<svg([^>]*?)\swidth="[^"]*"\sheight="[^"]*"/, '<svg$1')
  .replace('<svg', '<svg class="reveal" data-reveal');
---

<section class="hero" aria-labelledby="hero-title">
  <RadarMotif class="hero__motif" />
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <div class="hero__logo" set:html={lockup} />
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">{tag.head1}</span>
        <span class="hero__line"><span class="hl">{tag.head2}</span></span>
      </h1>
      <p class="hero__sub">
        {tag.sub.map((line) => <span>{line}</span>)}
      </p>
      <div class="hero__ctas">
        <a class="btn btn--lg btn--primary" href="#install">
          {t.hero.cta}
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="square"></path></svg>
        </a>
        <a class="btn btn--lg" href={PRODUCT_REPO}>
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.6 7.6 0 0 1 8 3.86c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          {t.hero.github}
        </a>
      </div>
      <ul class="chips" aria-label={lang === 'zh' ? '特点' : 'At a glance'}>
        {t.hero.chips.map((c) => <li class="chip">{c}</li>)}
      </ul>
    </div>
    <figure class="hero__video frame">
      <figcaption class="frame__bar">
        <span class="frame__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="frame__title">{t.hero.videoLabel}</span>
        <span class="frame__len">{duration(tour)}</span>
      </figcaption>
      <VideoSlot id="M-01" lang={lang} variant="hero" eager />
    </figure>
  </div>
</section>

<script>
  import { reveal } from '../../scripts/reveal';
  document.querySelectorAll<SVGSVGElement>('svg[data-reveal]').forEach((svg) => reveal(svg));
</script>
