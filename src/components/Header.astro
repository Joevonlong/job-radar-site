---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { COPY, type Lang } from '../i18n/ui';
import { docsUrl, localePath, url } from '../lib/site';
import { PRODUCT_REPO } from '../../site.config.mjs';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const t = COPY[lang].nav;
const home = url(localePath(lang, ''));
const links = [
  { href: `${home}#features`, label: t.features },
  { href: `${home}#how`, label: t.how },
  { href: `${home}#install`, label: t.install },
  { href: url(localePath(lang, 'tutorials/')), label: t.tutorials, current: path === 'tutorials/' },
  { href: docsUrl(lang), label: t.docs },
  { href: `${home}#faq`, label: t.faq },
];
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a class="site-header__brand" href={home} aria-label={t.home}><Logo height={32} /></a>
    <nav class="site-header__nav" aria-label={lang === 'zh' ? '主导航' : 'Main'}>
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-header__tools">
      <LangSwitch lang={lang} path={path} />
      <ThemeToggle lang={lang} />
      <a class="btn btn--sm btn--ink site-header__gh" href={PRODUCT_REPO}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.6 7.6 0 0 1 8 3.86c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
        <span>{t.github}</span>
      </a>
      <details class="site-menu">
        <summary class="icon-btn" aria-label={t.menu}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"></path></svg>
        </summary>
        <nav class="site-menu__panel" aria-label={t.menu}>
          <ul>
            {links.map((l) => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
            <li><a href={PRODUCT_REPO}>{t.github} ↗</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu after a pick, on Escape, and on a click outside.
  document.querySelectorAll<HTMLDetailsElement>('.site-menu').forEach((menu) => {
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.removeAttribute('open');
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.removeAttribute('open');
    });
  });
</script>
